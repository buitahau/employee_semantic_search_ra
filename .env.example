# --- Traditional DB (owt-employee-app-backend) ---
# Docker: docker-compose service source-db, mapped to host port 5433
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5433
SOURCE_DB_NAME=postgres
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=123456

# --- Vector DB (pgvector) ---
# Docker: docker-compose service vector-db, mapped to host port 5434
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5434
VECTOR_DB_NAME=vectordb
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=123456

# --- LLM (query analysis) ---
LLM_API_KEY=
LLM_BASE_URL=https://lightning.ai/api/v1
LLM_MODEL=openai/gpt-4.1-mini

# --- Embedding service ---
EMBEDDING_MODEL_PATH=models/all-MiniLM-L6-v2/all-MiniLM-L6-v2.onnx
